{
    "manifest_version": 3,
    "name": "Junk Shooter",
    "version": "1.0.0",
    "description": "Game where you need to shoot junk in the space to get points.",
    "action":{
        "default_popup": "index.html",
        "default_icon": "icons/128.png"
    },
    "icons": {
        "128":"icons/128.png"
    },
    "content_security_policy": {
    
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    },
    "permissions": [],
    "background":{}
}